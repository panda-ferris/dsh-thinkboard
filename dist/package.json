{
  "name": "dsh-thinkboard",
  "version": "0.1.0",
  "type": "module",
  "description": "ThinkBoard for DeepSeek Harness: an infinite canvas for Markdown and image cards, frames, flowchart shapes, and labeled connections. Boards are plain JSON files, and the built-in chat agent can read and edit them.",
  "license": "MIT",
  "author": "panda-ferris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panda-ferris/dsh-thinkboard.git"
  },
  "homepage": "https://github.com/panda-ferris/dsh-thinkboard#readme",
  "bugs": {
    "url": "https://github.com/panda-ferris/dsh-thinkboard/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "whiteboard",
    "canvas",
    "board",
    "flowchart",
    "markdown",
    "knowledge-management"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.2.2-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": [],
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
